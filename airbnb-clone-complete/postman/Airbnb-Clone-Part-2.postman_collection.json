    {
      "name": "11. Check availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/check-availability?propertyId={{propertyId}}&checkIn={{checkIn}}&checkOut={{checkOut}}&guests=2"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "function dateIn(days) {",
              "  const value = new Date();",
              "  value.setUTCHours(0, 0, 0, 0);",
              "  value.setUTCDate(value.getUTCDate() + days);",
              "  return value.toISOString().slice(0, 10);",
              "}",
              "pm.collectionVariables.set('checkIn', dateIn(14));",
              "pm.collectionVariables.set('checkOut', dateIn(17));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Availability checked', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('available'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Create booking hold",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{guestToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "function dateIn(days) {",
              "  const value = new Date();",
              "  value.setUTCHours(0, 0, 0, 0);",
              "  value.setUTCDate(value.getUTCDate() + days);",
              "  return value.toISOString().slice(0, 10);",
              "}",
              "pm.collectionVariables.set('checkIn', dateIn(14));",
              "pm.collectionVariables.set('checkOut', dateIn(17));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  if (data.data && data.data._id) pm.collectionVariables.set('bookingId', data.data._id);",
              "}",
              "",
              "pm.test('Booking hold created', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
