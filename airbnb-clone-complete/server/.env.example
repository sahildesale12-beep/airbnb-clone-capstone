# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Local development uses a temporary MongoDB automatically by default.
# To use persistent MongoDB Atlas/local server: set USE_MEMORY_DB=false and MONGODB_URI.
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/airbnb_clone
SEED_DEMO_DATA=true

# Leave blank for auto-generated local development secrets. Set strong, unique values in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional uploads. If Cloudinary is not configured, uploads save to server/public/uploads in development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Stripe test-mode keys. Without these, the app uses a clearly labelled development demo payment flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
